{
  "expo": {
    "name": "نور",
    "slug": "noor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.noor.health"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E8C93",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.noor.health"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج نور الوصول لصورك لرفع صور الفحوصات.",
          "cameraPermission": "يحتاج نور الكاميرا لتصوير التقارير والفحوصات."
        }
      ]
    ],
    "scheme": "noor",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://noor-yzbg.onrender.com"
    }
  }
}